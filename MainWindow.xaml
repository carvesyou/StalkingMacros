                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DataTemplate x:Key="MacroCardTemplate">
            <Border Margin="5" Padding="16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                        <Setter Property="Height" Value="182" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDesync}" Value="True">
                                <Setter Property="Height" Value="224" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoadoutSwap}" Value="True">
                                <Setter Property="Height" Value="224" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="4" Height="32" CornerRadius="2" Background="{Binding AccentBrush}" Margin="0,0,11,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontFamily="Corbel" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="{Binding Category}" Foreground="{Binding AccentBrush}" FontSize="8.5" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+" Click="AddLoadoutSwapper_Click" Width="30" Height="30" Padding="0"
                                    Margin="0,0,9,0" ToolTip="Add a second Loadout Swapper with its own bind and loadout.">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="FontSize" Value="19" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="#A8E6C0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanAddLoadoutSwap}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="−" Click="RemoveLoadoutSwapper_Click" Width="30" Height="30" Padding="0"
                                    Margin="0,0,9,0" ToolTip="Remove this additional Loadout Swapper.">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="FontSize" Value="17" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="#A8E6C0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanRemoveLoadoutSwap}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <ToggleButton Style="{StaticResource MacroToggle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="MacroToggle_Click" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,9,0,5">
                        <TextBlock Text="{Binding Description}" Foreground="#AEBAB3" FontSize="10.5" LineHeight="15" TextWrapping="Wrap" />
                        <UniformGrid Columns="4" Margin="0,8,0,0">
                            <UniformGrid.Style>
                                <Style TargetType="UniformGrid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDesync}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </UniformGrid.Style>
                            <ComboBox MinHeight="38" FontSize="12" Margin="2,0" ToolTip="First Desync loadout"
                                      ItemsSource="{Binding DataContext.LoadoutOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="ShortName" SelectedValuePath="Number" SelectedValue="{Binding SelectedLoadout, Mode=TwoWay}"
                                      Style="{StaticResource DarkComboBox}" />
                            <ComboBox MinHeight="38" FontSize="12" Margin="2,0" ToolTip="Second Desync loadout"
                                      ItemsSource="{Binding DataContext.LoadoutOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="ShortName" SelectedValuePath="Number" SelectedValue="{Binding SelectedLoadoutSecondary, Mode=TwoWay}"
                                      Style="{StaticResource DarkComboBox}" />
                            <ComboBox MinHeight="38" FontSize="12" Margin="2,0" ToolTip="Third Desync loadout"
                                      ItemsSource="{Binding DataContext.LoadoutOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="ShortName" SelectedValuePath="Number" SelectedValue="{Binding SelectedLoadoutTertiary, Mode=TwoWay}"
                                      Style="{StaticResource DarkComboBox}" />
                            <ComboBox MinHeight="38" FontSize="12" Margin="2,0" ToolTip="Fourth Desync loadout"
                                      ItemsSource="{Binding DataContext.LoadoutOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="ShortName" SelectedValuePath="Number" SelectedValue="{Binding SelectedLoadoutQuaternary, Mode=TwoWay}"
                                      Style="{StaticResource DarkComboBox}" />
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadoutSwap}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel>
                                <TextBlock Text="LOADOUT A" Foreground="#A8E6C0" FontSize="8.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <ComboBox Width="78" MinHeight="38" FontSize="12" ToolTip="Used on the first press, then every other press."
                                          ItemsSource="{Binding DataContext.LoadoutOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="ShortName" SelectedValuePath="Number"
                                          SelectedValue="{Binding SelectedLoadout, Mode=TwoWay}"
                                          Style="{StaticResource DarkComboBox}" />
                            </StackPanel>
                            <TextBlock Text="⇄" Foreground="#A8E6C0" FontSize="15" FontWeight="Bold"
                                       Margin="9,15,9,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="LOADOUT B" Foreground="#A8E6C0" FontSize="8.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <ComboBox Width="78" MinHeight="38" FontSize="12" ToolTip="Used on the second press, then every other press."
                                          ItemsSource="{Binding DataContext.LoadoutOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="ShortName" SelectedValuePath="Number"
                                          SelectedValue="{Binding SelectedLoadoutSecondary, Mode=TwoWay}"
                                          Style="{StaticResource DarkComboBox}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,5,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ComboBox Width="78" VerticalAlignment="Center"
                                  ItemsSource="{Binding DataContext.ActivationModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Name" SelectedValuePath="Mode"
                                  SelectedValue="{Binding ActivationMode, Mode=TwoWay}"
                                  ToolTip="Choose One Time, Hold, or Toggle behavior.">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActivationModeLocked}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        </StackPanel>
                        <Button DataContext="{Binding}" Click="CaptureMacro_Click" MinWidth="90" HorizontalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KeybindButton}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border MinWidth="36" Height="25" Background="#111111" BorderBrush="#3D3D3D"
                                        BorderThickness="1" CornerRadius="6" Padding="5,0">
                                    <TextBlock Text="{Binding BindingDisplay}" Foreground="#BDF2D0" FontWeight="Bold"
                                               FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="7,0,1,0" VerticalAlignment="Center">
                                    <TextBlock Text="BIND" Foreground="#A8E6C0" FontSize="7.5" FontWeight="Bold" />
                                    <TextBlock Text="CHANGE" Foreground="#858585" FontSize="7" FontWeight="Bold" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ControllerSkateCardTemplate">
            <Border Style="{StaticResource CardBorder}" Margin="5" Padding="16" Height="190">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="4" Height="32" CornerRadius="2" Background="{Binding AccentBrush}" Margin="0,0,11,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontFamily="Corbel" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="{Binding Category}" Foreground="{Binding AccentBrush}" FontSize="8.5" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource MacroToggle}" IsChecked="{Binding ControllerIsEnabled, Mode=TwoWay}" Click="ControllerMacroToggle_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding ControllerDescription}" Foreground="#AEBAB3" FontSize="10.5" LineHeight="15"
                               TextWrapping="Wrap" Margin="0,10,0,5" />
                    <Grid Grid.Row="2" Margin="0,7,0,0">
                            <Button DataContext="{Binding}" Click="CaptureControllerBind_Click" MinWidth="96"
                                    HorizontalAlignment="Center" Style="{StaticResource KeybindButton}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border MinWidth="36" Height="25" Background="#111111" BorderBrush="#3D3D3D"
                                            BorderThickness="1" CornerRadius="6" Padding="5,0">
                                        <TextBlock Text="{Binding ControllerBindingDisplay}" Foreground="#BDF2D0" FontWeight="Bold"
                                                   FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="7,0,1,0" VerticalAlignment="Center">
                                        <TextBlock Text="PAD BIND" Foreground="#A8E6C0" FontSize="7.5" FontWeight="Bold" />
                                        <TextBlock Text="CHANGE" Foreground="#858585" FontSize="7" FontWeight="Bold" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="#000000" BorderBrush="#252525" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#080808" BorderBrush="#4C765B" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="/" Foreground="#BDF2D0" FontFamily="Corbel" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="STALKING" FontFamily="Corbel" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="MACRO CONTROL" Foreground="#777777" FontSize="7.5" FontWeight="Bold" Margin="0,1,0,0" />
                    </StackPanel>
                    <TextBlock Text="v1.01" Foreground="#A8E6C0" FontFamily="Corbel" FontSize="10" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="11,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" ToolTip="Minimize" Click="Minimize_Click">
                        <Rectangle Width="11" Height="1.4" RadiusX="0.7" RadiusY="0.7" Fill="#D8DDE5" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Maximize / Restore" Click="Maximize_Click">
                        <Border Width="10" Height="10" BorderBrush="#D8DDE5" BorderThickness="1.2" CornerRadius="0.5" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Close" Click="CloseToTray_Click">
                        <Grid Width="11" Height="11">
                            <Rectangle Width="13" Height="1.4" RadiusX="0.7" RadiusY="0.7" Fill="#D8DDE5" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="13" Height="1.4" RadiusX="0.7" RadiusY="0.7" Fill="#D8DDE5" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-45" /></Rectangle.RenderTransform></Rectangle>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="194" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#252525" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="WORKSPACES" Margin="24,0,0,9" Foreground="#777777" FontFamily="Corbel" FontSize="9" FontWeight="Bold" />
                        <RadioButton x:Name="DashboardNav" GroupName="Navigation" IsChecked="True" Content="Destiny" Style="{StaticResource NavButton}" Click="Navigate_Click">
                            <RadioButton.Tag>
                                <Image Source="{StaticResource DestinyTricornIcon}" Width="18" Height="18" Stretch="Uniform" />
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="SitesNav" GroupName="Navigation" Content="Sites" Style="{StaticResource NavButton}" Click="Navigate_Click">
                            <RadioButton.Tag>
                                <Viewbox Width="18" Height="18" Stretch="Uniform">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Fill="Transparent"
                                                 Stroke="#A8E6C0" StrokeThickness="1.5" />
                                        <Ellipse Canvas.Left="8" Canvas.Top="3" Width="8" Height="18" Fill="Transparent"
                                                 Stroke="#A8E6C0" StrokeThickness="1.2" />
                                        <Path Data="M3.7,9 L20.3,9 M3.7,15 L20.3,15" Stroke="#A8E6C0" StrokeThickness="1.2" />
                                    </Canvas>
                                </Viewbox>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="FortniteNav" GroupName="Navigation" Content="Fortnite" Style="{StaticResource NavButton}" Click="Navigate_Click">
                            <RadioButton.Tag>
                                <TextBlock Text="F" Width="18" TextAlignment="Center" FontFamily="Corbel" FontSize="17"
                                           FontWeight="Bold" Foreground="#A8E6C0" />
                            </RadioButton.Tag>
                        </RadioButton>
                    </StackPanel>

                    <Button Grid.Row="1" Content="CHECK FOR UPDATES" Click="CheckForUpdates_Click"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="16,0,0,16" Padding="13,8" FontSize="8.5" />

                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Column="1" Background="{StaticResource PageBrush}">
                <!-- Destiny workspace -->
                <Grid x:Name="DestinyPage" Background="{StaticResource PageBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="74" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Margin="26,10,26,8" Background="#080808" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="11" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,18,0">
                                <Ellipse Width="7" Height="7" Fill="#A8E6C0" Margin="0,0,8,0" />
                                <TextBlock Text="DESTINY 2" Foreground="#B8B8B8" FontSize="9" FontWeight="Bold" />
                            </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <RadioButton x:Name="DestinySkatesTab" GroupName="DestinyCategories" IsChecked="True" Content="Keyboard" Tag="Keyboard"
                                         Style="{StaticResource SiteSwitchButton}" Click="DestinyCategory_Click" />
                            <RadioButton x:Name="DestinyControllerTab" GroupName="DestinyCategories" Content="Controller" Tag="Controller"
                                         Style="{StaticResource SiteSwitchButton}" Click="DestinyCategory_Click" />
                            <RadioButton x:Name="DestinyInventoryTab" GroupName="DestinyCategories" Content="Inventory" Tag="Inventory"
                                         Style="{StaticResource SiteSwitchButton}" Click="DestinyCategory_Click" />
                            <RadioButton x:Name="DestinyMiscTab" GroupName="DestinyCategories" Content="Misc" Tag="Misc"
                                         Style="{StaticResource SiteSwitchButton}" Click="DestinyCategory_Click" />
                            <RadioButton x:Name="DestinyBindsTab" GroupName="DestinyCategories" Content="K&amp;M Binds" Tag="Binds"
                                         Style="{StaticResource SiteSwitchButton}" Click="DestinyCategory_Click" />
                        </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                <!-- Dashboard category page -->
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" PanningMode="VerticalOnly" IsDeferredScrollingEnabled="False">
                    <StackPanel Margin="26,22,26,24">
                        <TextBlock x:Name="DestinyPageTitle" Text="Keyboard Macros" Style="{StaticResource PageTitle}" />

                        <StackPanel x:Name="SkatesSection">
                            <Grid Margin="5,14,5,10">
                                <Border Background="#080808" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="9" Padding="5" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="HunterSkatesTab" GroupName="SkateClasses" IsChecked="True" Content="Hunter" Tag="Hunter"
                                                     Style="{StaticResource SiteSwitchButton}" Click="SkateClass_Click" />
                                        <RadioButton x:Name="WarlockSkatesTab" GroupName="SkateClasses" Content="Warlock" Tag="Warlock"
                                                     Style="{StaticResource SiteSwitchButton}" Click="SkateClass_Click" />
                                        <RadioButton x:Name="TitanSkatesTab" GroupName="SkateClasses" Content="Titan" Tag="Titan"
                                                     Style="{StaticResource SiteSwitchButton}" Click="SkateClass_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <StackPanel x:Name="HunterSkatesPage">
                                <TextBlock Text="HUNTER" Foreground="#A8E6C0" FontFamily="Corbel" FontWeight="Bold" FontSize="13" Margin="5,3,0,4" />
                                <ItemsControl ItemsSource="{Binding HunterSkates}" ItemTemplate="{StaticResource MacroCardTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel x:Name="WarlockSkatesPage" Visibility="Collapsed">
                                <TextBlock Text="WARLOCK" Foreground="#C0F0D2" FontFamily="Corbel" FontWeight="Bold" FontSize="13" Margin="5,3,0,4" />
                                <ItemsControl ItemsSource="{Binding WarlockSkates}" ItemTemplate="{StaticResource MacroCardTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel x:Name="TitanSkatesPage" Visibility="Collapsed">
                                <TextBlock Text="TITAN" Foreground="#9FE2BA" FontFamily="Corbel" FontWeight="Bold" FontSize="13" Margin="5,3,0,4" />
                                <ItemsControl ItemsSource="{Binding TitanSkates}" ItemTemplate="{StaticResource MacroCardTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border Background="#080808" BorderBrush="#2B2B2B" BorderThickness="1" CornerRadius="10" Padding="12" Margin="5,10,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#A8E6C0" Margin="0,0,10,0" />
                                        <TextBlock Text="Bubble Skate requires Ward of Dawn and a ledge. Its strict timing can consume Super on a failed attempt." Foreground="#A0A0A0" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="InventorySection" Visibility="Collapsed">
                            <ItemsControl ItemsSource="{Binding InventoryMacros}" ItemTemplate="{StaticResource MacroCardTemplate}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="MiscSection" Visibility="Collapsed">
                            <ItemsControl ItemsSource="{Binding MiscMacros}" ItemTemplate="{StaticResource MacroCardTemplate}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Style="{StaticResource CardBorder}" Margin="5,12,5,0" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Rocket Grapple Setup" FontFamily="Corbel" FontWeight="Bold" FontSize="19" />
                                        <TextBlock Text="Enter your exact Destiny 2 mouse sensitivity. The recoil correction scales automatically, so every sensitivity from 1–100 uses the same online reference curve."
                                                   Foreground="#AEBAB3" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="IN-GAME SENSITIVITY" Foreground="#858585" FontSize="8" FontWeight="Bold" Margin="1,0,0,5" />
                                        <TextBox Text="{Binding Timings.RocketSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Enter the exact Destiny 2 mouse sensitivity used while firing the rocket." />
                                        <TextBlock Text="{Binding Timings.RocketRecoilDisplay}" Foreground="#A8E6C0" FontSize="7.5"
                                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="5,12,5,0" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Slipstream Setup" FontFamily="Corbel" FontWeight="Bold" FontSize="19" />
                                        <TextBlock Text="Hold the Slipstream Assist bind while parked square to a clean ledge. It summons, launches, then repeats the post-patch back-pitch, Destabilizer and dedicated Dodge Left rhythm. Release the bind at any time to release every vehicle input."
                                                   Foreground="#AEBAB3" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <TextBlock Text="MATCH SPARROW DODGE LEFT IN GAME BINDS — IT IS SEPARATE FROM STEER LEFT"
                                                   Foreground="#C8F3D7" FontSize="8.5" FontWeight="Bold" TextWrapping="Wrap" Margin="0,9,0,0" />
                                        <TextBlock Text="FREE ROAM / RAIDS ONLY — MONUMENT OF TRIUMPH SRL DISABLES SPARROW DESTABILIZERS"
                                                   Foreground="#A8E6C0" FontSize="8.5" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="STABLE FPS CAP" Foreground="#858585" FontSize="8" FontWeight="Bold" Margin="1,0,0,5" />
                                        <ComboBox ItemsSource="{Binding FpsOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Fps"
                                                  SelectedValue="{Binding Timings.SparrowFps, Mode=TwoWay}" Style="{StaticResource DarkComboBox}"
                                                  ToolTip="Choose the preset closest to your stable in-game FPS cap for frame-aligned dodge timing." />
                                        <TextBlock Text="{Binding Timings.SparrowRhythmDisplay}" Foreground="#A8E6C0" FontSize="7.5"
                                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="5,12,5,0" Padding="18">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Wish Wall Setup &amp; Guide" FontFamily="Corbel" FontWeight="Bold" FontSize="19" />
                                            <TextBlock Text="Everything needed to run the optimized wall_menu4 sequence." Foreground="#909A94"
                                                       FontSize="10.5" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#07100A" BorderBrush="#315B40" BorderThickness="1"
                                                CornerRadius="7" Padding="9,5" VerticalAlignment="Center">
                                            <TextBlock Text="DIVINITY REQUIRED" Foreground="#A8E6C0" FontSize="8.5" FontWeight="Bold" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.72*" /><ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="0.72*" /><ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="1.56*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="SENSITIVITY" Foreground="#858585" FontSize="8" FontWeight="Bold" Margin="1,0,0,5" />
                                            <TextBox Text="{Binding Wall.Sensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Enter the exact Destiny 2 in-game mouse sensitivity. Sensitivity 6 is recommended." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="FPS CAP PRESET" Foreground="#858585" FontSize="8" FontWeight="Bold" Margin="1,0,0,5" />
                                            <ComboBox ItemsSource="{Binding FpsOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Fps"
                                                      SelectedValue="{Binding Wall.Fps, Mode=TwoWay}" Style="{StaticResource DarkComboBox}"
                                                      ToolTip="Choose the preset closest to your stable in-game FPS cap." />
                                            <TextBlock Text="{Binding Wall.SpeedProfileDisplay}" Foreground="#A8E6C0" FontSize="7.5"
                                                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="WISH" Foreground="#858585" FontSize="8" FontWeight="Bold" Margin="1,0,0,5" />
                                            <ComboBox ItemsSource="{Binding WishOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Number"
                                                      SelectedValue="{Binding Wall.WishNumber, Mode=TwoWay}" Style="{StaticResource DarkComboBox}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="#242424" Margin="0,17,0,15" />

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="BEFORE STARTING" Foreground="#A8E6C0" FontSize="9" FontWeight="Bold" Margin="0,0,0,8" />
                                            <TextBlock Text="1  Equip Divinity and make sure it has ammunition." Foreground="#D8D8D8" FontSize="11" Margin="0,0,0,7" />
                                            <TextBlock Text="2  Use a standard 16:9 display; ultrawide is not supported reliably." Foreground="#D8D8D8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7" />
                                            <TextBlock Text="3  Enter the exact in-game sensitivity above. Sensitivity 6 is the recommended baseline." Foreground="#D8D8D8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7" />
                                            <TextBlock Text="4  Enter a stable FPS cap. The app automatically selects: ≤75 FPS = 110 ms, 76–119 = 100 ms, 120–179 = 90 ms, 180+ = 80 ms." Foreground="#D8D8D8" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="RUNNING THE MACRO" Foreground="#A8E6C0" FontSize="9" FontWeight="Bold" Margin="0,0,0,8" />
                                            <TextBlock Text="5  Stand directly behind the center activation plate and face the wall." Foreground="#D8D8D8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7" />
                                            <TextBlock Text="6  Put the crosshair exactly in the center of the top-left circle, then do not move." Foreground="#D8D8D8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7" />
                                            <TextBlock Text="7  Select the wish, focus Destiny 2, and press the Wish Wall bind once. Keep your hands off the mouse and movement keys." Foreground="#D8D8D8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7" />
                                            <TextBlock Text="8  Wait for completion. The macro reloads when needed, returns to the plate, and submits the wish automatically. Press the bind again or use Panic to cancel." Foreground="#D8D8D8" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#070707" BorderBrush="#292929" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,16,0,0">
                                        <TextBlock Text="If shots miss: verify Divinity, exact sensitivity, a stable FPS cap, 16:9 resolution, the centered top-left starting point, and that Destiny 2 stayed focused for the entire run."
                                                   Foreground="#AEBAB3" FontSize="10.5" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Game binds page -->
                <ScrollViewer x:Name="BindsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" PanningMode="VerticalOnly" IsDeferredScrollingEnabled="False">
                    <StackPanel Margin="26,22,26,24">
                        <TextBlock Text="Keyboard &amp; Mouse Binds" Style="{StaticResource PageTitle}" />
                        <Border Background="#080808" BorderBrush="#2B2B2B" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#A8E6C0" Margin="0,0,10,0" />
                                <TextBlock Text="Air Move, Super, and loadout menu controls can all be changed here." Foreground="#B8B8B8" FontSize="11.5" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding GameBindItems}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}" Margin="5" Padding="15" Height="112">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="4,0,16,0">
                                                <TextBlock Text="{Binding Name}" FontFamily="Corbel" FontWeight="Bold" FontSize="15" />
                                                <TextBlock Text="{Binding Description}" Foreground="#AAAAAA" FontSize="11" LineHeight="16" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" DataContext="{Binding}" Click="CaptureGameBind_Click" Style="{StaticResource KeybindButton}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border MinWidth="42" Height="27" Background="#151515" BorderBrush="#414141" BorderThickness="1" CornerRadius="6" Padding="7,0">
                                                        <TextBlock Text="{Binding BindingDisplay}" Foreground="#BDF2D0" FontWeight="Bold" FontSize="9.5"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Margin="8,0,1,0" VerticalAlignment="Center">
                                                        <TextBlock Text="KEYBIND" Foreground="#A8E6C0" FontSize="7.5" FontWeight="Bold" />
                                                        <TextBlock Text="CHANGE" Foreground="#8E8E8E" FontSize="7.5" FontWeight="Bold" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="RUN FIRST-START SETUP AGAIN" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right" Margin="0,12,4,0" Click="ShowSetup_Click" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Controller buttons trigger the same native K&M sequences used by the Keyboard page. -->
                <ScrollViewer x:Name="ControllerSkatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly"
                              IsDeferredScrollingEnabled="False">
                    <StackPanel Margin="26,22,26,24">
                        <TextBlock Text="Controller Macros" Style="{StaticResource PageTitle}" />
                        <Grid Margin="5,14,5,10">
                            <Border Background="#080808" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="9" Padding="5" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="ControllerSkateClasses" IsChecked="True" Content="Hunter" Tag="Hunter"
                                                 Style="{StaticResource SiteSwitchButton}" Click="ControllerSkateClass_Click" />
                                    <RadioButton GroupName="ControllerSkateClasses" Content="Warlock" Tag="Warlock"
                                                 Style="{StaticResource SiteSwitchButton}" Click="ControllerSkateClass_Click" />
                                    <RadioButton GroupName="ControllerSkateClasses" Content="Titan" Tag="Titan"
                                                 Style="{StaticResource SiteSwitchButton}" Click="ControllerSkateClass_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="ControllerHunterPage">
                            <TextBlock Text="HUNTER" Foreground="#A8E6C0" FontWeight="Bold" FontSize="13" Margin="5,3,0,4" />
                            <ItemsControl ItemsSource="{Binding HunterSkates}" ItemTemplate="{StaticResource ControllerSkateCardTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="ControllerWarlockPage" Visibility="Collapsed">
                            <TextBlock Text="WARLOCK" Foreground="#C0F0D2" FontWeight="Bold" FontSize="13" Margin="5,3,0,4" />
                            <ItemsControl ItemsSource="{Binding WarlockSkates}" ItemTemplate="{StaticResource ControllerSkateCardTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="ControllerTitanPage" Visibility="Collapsed">
                            <TextBlock Text="TITAN" Foreground="#9FE2BA" FontWeight="Bold" FontSize="13" Margin="5,3,0,4" />
                            <ItemsControl ItemsSource="{Binding TitanSkates}" ItemTemplate="{StaticResource ControllerSkateCardTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Embedded Destiny community sites -->
                <Grid x:Name="SitesPage" Visibility="Collapsed" Background="{StaticResource PageBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="74" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Margin="26,10,26,8" Background="#080808" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="12" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="DimSiteTab" GroupName="Sites" IsChecked="True" Content="DIM"
                                             Tag="https://app.destinyitemmanager.com/" Style="{StaticResource SiteSwitchButton}" Click="SiteTab_Click" />
                                <RadioButton x:Name="ArmorSiteTab" GroupName="Sites" Content="D2ArmorPicker"
                                             Tag="https://d2armorpicker.com/" Style="{StaticResource SiteSwitchButton}" Click="SiteTab_Click" />
                                <RadioButton x:Name="CheckpointSiteTab" GroupName="Sites" Content="D2Checkpoint"
                                             Tag="https://d2checkpoint.com/" Style="{StaticResource SiteSwitchButton}" Click="SiteTab_Click" />
                                <RadioButton x:Name="LightGgSiteTab" GroupName="Sites" Content="Light.gg"
                                             Tag="https://www.light.gg/" Style="{StaticResource SiteSwitchButton}" Click="SiteTab_Click" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="←" Style="{StaticResource IconButton}" FontSize="17" ToolTip="Back" Click="SitesBack_Click" />
                                <Button Content="→" Style="{StaticResource IconButton}" FontSize="17" ToolTip="Forward" Click="SitesForward_Click" />
                                <Button Content="↻" Style="{StaticResource IconButton}" FontSize="17" ToolTip="Reload" Click="SitesReload_Click" />
                                <Button Content="↗" Style="{StaticResource IconButton}" FontSize="17" ToolTip="Open in your browser" Click="SitesExternal_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Margin="26,0,26,24" Padding="6" Background="#050505"
                            BorderBrush="#343A36" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                        <Grid>
                            <Border Background="#080808" CornerRadius="9" />
                            <Grid x:Name="SitesBrowserHost" Margin="1" Background="#080808" />
                            <Border x:Name="SitesStatusPanel" Margin="1" Background="#080808" CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="SitesStatusTitle" Text="Loading Destiny sites…" Foreground="#BDF2D0"
                                               FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="SitesStatusDetail" Text="The embedded browser is starting." Foreground="#9A9A9A"
                                               FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" Margin="0,7,0,0" />
                                    <Button x:Name="SitesFallbackButton" Content="OPEN IN DEFAULT BROWSER" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Center" Margin="0,18,0,0" Click="SitesExternal_Click" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Fortnite workspace -->
                <Grid x:Name="FortnitePage" Visibility="Collapsed" Background="{StaticResource PageBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="74" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Margin="26,10,26,8" Background="#080808" BorderBrush="#2C2C2C" BorderThickness="1"
                            CornerRadius="11" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="FORTNITE" Foreground="#B8B8B8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,18,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <RadioButton x:Name="FortniteMacrosTab" GroupName="FortniteCategories" IsChecked="True"
                                         Content="Macros" Tag="Macros" Style="{StaticResource SiteSwitchButton}"
                                         Click="FortniteCategory_Click" />
                            <RadioButton x:Name="FortniteBindsTab" GroupName="FortniteCategories"
                                         Content="Keybinds" Tag="Binds" Style="{StaticResource SiteSwitchButton}"
                                         Click="FortniteCategory_Click" />
                        </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="FortniteMacrosPage" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                                      PanningMode="VerticalOnly" IsDeferredScrollingEnabled="False">
                            <StackPanel Margin="26,22,26,24">
                                <TextBlock Text="Fortnite Macros" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="EDITING" Style="{StaticResource SectionLabel}" Margin="5,14,0,5" />
                                <ItemsControl ItemsSource="{Binding FortniteMacros}" ItemTemplate="{StaticResource MacroCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="FortniteBindsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                                      PanningMode="VerticalOnly" IsDeferredScrollingEnabled="False">
                            <StackPanel Margin="26,22,26,24">
                                <TextBlock Text="Fortnite Keybinds" Style="{StaticResource PageTitle}" />
                                <Border Background="#080808" BorderBrush="#2B2B2B" BorderThickness="1" CornerRadius="10"
                                        Padding="12" Margin="4,18,4,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#A8E6C0" Margin="0,0,10,0" />
                                        <TextBlock Text="Set Edit and Select here; set each macro's activation key on its card. Keyboard and mouse inputs are supported."
                                                   Foreground="#B8B8B8" FontSize="11.5" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding FortniteBindItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardBorder}" Margin="5" Padding="15" Height="112">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Margin="4,0,16,0">
                                                        <TextBlock Text="{Binding Name}" FontFamily="Corbel" FontWeight="Bold" FontSize="15" />
                                                        <TextBlock Text="{Binding Description}" Foreground="#AAAAAA" FontSize="11"
                                                                   LineHeight="16" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" DataContext="{Binding}" Click="CaptureGameBind_Click"
                                                            Style="{StaticResource KeybindButton}" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border MinWidth="42" Height="27" Background="#151515" BorderBrush="#414141"
                                                                    BorderThickness="1" CornerRadius="6" Padding="7,0">
                                                                <TextBlock Text="{Binding BindingDisplay}" Foreground="#BDF2D0" FontWeight="Bold"
                                                                           FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Margin="8,0,1,0" VerticalAlignment="Center">
                                                                <TextBlock Text="KEYBIND" Foreground="#A8E6C0" FontSize="7.5" FontWeight="Bold" />
                                                                <TextBlock Text="CHANGE" Foreground="#8E8E8E" FontSize="7.5" FontWeight="Bold" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>

        <!-- First-run setup overlay -->
        <Grid x:Name="SetupOverlay" Grid.RowSpan="2" Background="#E6000000" Visibility="Collapsed" Panel.ZIndex="50">
            <Border Width="610" Background="#080808" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="16" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="54" Height="54" Background="#0D0D0D" BorderBrush="#A8E6C0" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Left">
                        <TextBlock Text="1" Foreground="#A8E6C0" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Match your Destiny 2 binds" FontSize="23" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <TextBlock Text="Before enabling Shatterskate or Wellskate, capture the exact physical keys assigned to Air Move / Shatterdive and Super." Foreground="#A0A0A0" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,20" />
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="#0A0A0A" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="15">
                            <StackPanel><TextBlock Text="AIR MOVE / SHATTERDIVE" Foreground="#A8E6C0" FontWeight="Bold" FontSize="9" /><TextBlock x:Name="SetupAirMoveText" Text="X" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,10" /><Button Content="CAPTURE KEY" Tag="AirMove" Click="SetupCapture_Click" Style="{StaticResource SecondaryButton}" /></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#0A0A0A" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="15">
                            <StackPanel><TextBlock Text="SUPER" Foreground="#BDF2D0" FontWeight="Bold" FontSize="9" /><TextBlock x:Name="SetupSuperText" Text="F" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,10" /><Button Content="CAPTURE KEY" Tag="Super" Click="SetupCapture_Click" Style="{StaticResource SecondaryButton}" /></StackPanel>
                        </Border>
                    </Grid>
                    <Button Content="SAVE AND OPEN DESTINY" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" Click="CompleteSetup_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Input capture overlay -->
        <Grid x:Name="CaptureOverlay" Grid.RowSpan="2" Background="#EE000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="500" Background="#080808" BorderBrush="#303030" BorderThickness="1" CornerRadius="16" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Width="72" Height="72" HorizontalAlignment="Center">
                        <Ellipse Stroke="#A8E6C0" StrokeThickness="2" Opacity="0.5" />
                        <Ellipse Width="48" Height="48" Fill="#151515" />
                        <TextBlock Text="&#xE928;" FontFamily="Segoe MDL2 Assets" Foreground="#BDF2D0" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="CaptureTitleText" Text="Press a key" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                    <TextBlock x:Name="CaptureHelpText" Text="Press any keyboard key or mouse button." Foreground="#A0A0A0" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Margin="20,9,20,0" />
                    <Button Content="CANCEL CAPTURE" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,22,0,0" Click="CancelCapture_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Close choice -->
        <Grid x:Name="CloseChoiceOverlay" Grid.RowSpan="2" Background="#EE000000" Visibility="Collapsed" Panel.ZIndex="150">
            <Border Width="460" Background="#080808" BorderBrush="#303030" BorderThickness="1" CornerRadius="16" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="42" Height="42" Background="#151515" BorderBrush="#303030" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Left">
                        <Grid Width="13" Height="13">
                            <Rectangle Width="15" Height="1.5" Fill="#BDF2D0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="15" Height="1.5" Fill="#BDF2D0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-45" /></Rectangle.RenderTransform></Rectangle>
                        </Grid>
                    </Border>
                    <TextBlock Text="Close /stalking macro?" FontFamily="Corbel" FontSize="24" FontWeight="Bold" Margin="0,18,0,0" />
                    <TextBlock Text="Shut Down stops every macro, releases controlled inputs and exits. Minimize to Tray keeps your enabled binds running in the background." Foreground="#A0A0A0" TextWrapping="Wrap" FontSize="11" LineHeight="18" Margin="0,8,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Content="MINIMIZE TO TRAY" Style="{StaticResource SecondaryButton}" Click="MinimizeToTray_Click" />
                        <Button Grid.Column="2" Content="SHUT DOWN" Style="{StaticResource DangerButton}" Click="ForceShutdown_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toast -->
        <Border x:Name="ToastBorder" Grid.RowSpan="2" Background="#0A0A0A" BorderBrush="#343434" BorderThickness="1" CornerRadius="10" Padding="15,11"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Visibility="Collapsed" Panel.ZIndex="200">
            <TextBlock x:Name="ToastText" Text="Saved" FontSize="11" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
