                <DrawingGroup>
                    <GeometryDrawing Brush="#BDF2D0" Geometry="M13.451 15.025q0.475 0.56 1.337 0.906c0.314 0.163 0.685 0.259 1.078 0.259h0c0.416-0.003 0.817-0.066 1.195-0.18l-0.030 0.008c0.262-0.070 0.492-0.173 0.7-0.308l-0.009 0.006c0.228-0.142 0.426-0.299 0.604-0.475l-0 0c0.306-0.295 0.565-0.637 0.766-1.013l0.011-0.022c0.164-0.336 0.259-0.731 0.259-1.148 0-0.021-0-0.042-0.001-0.063l0 0.003v-6.082c0-0.005 0-0.012 0-0.019 0-0.254-0.031-0.5-0.091-0.736l0.004 0.021c-0.218-0.676-0.607-1.246-1.116-1.678l-0.005-0.004q-0.776-0.647-1.898-0.733c-0.123-0.028-0.265-0.043-0.41-0.043s-0.287 0.016-0.423 0.046l0.013-0.002c-0.319 0.074-0.592 0.163-0.855 0.272l0.036-0.013c-0.604 0.264-1.102 0.678-1.459 1.196l-0.007 0.011c-0.325 0.492-0.518 1.095-0.518 1.744 0 0.024 0 0.048 0.001 0.072l-0-0.004v5.694c-0 0.005-0 0.011-0 0.017 0 0.162 0.016 0.32 0.046 0.473l-0.003-0.015c0.025 0.116 0.041 0.25 0.043 0.387l0 0.002c0.154 0.547 0.406 1.023 0.739 1.431l-0.006-0.007z" />
